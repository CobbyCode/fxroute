#cloud-config
# FXRoute Ubuntu 26.04 autoinstall (Subiquity, Desktop-ISO).
# Shared base for generate-seeds.py: keyboard, identity and network (Wi-Fi)
# stay interactive. Locale/keymap are English starting values.
# Network: no `network:` key -> Subiquity/Curtin carries the connection
# configured in the installer (including Wi-Fi) to the target via netplan.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  source:
    id: ubuntu-desktop-minimal
  interactive-sections:
    # The usual Ubuntu questions: keyboard, Wi-Fi once, the user here.
    # Everything else (locale, storage, packages) runs automatically.
    - keyboard
    - network
    - identity
  # Leave identity unset: Subiquity validates supplied mappings before
  # showing the interactive page and requires a password in that mapping.
  storage:
    layout:
      name: lvm
  packages:
    - openssh-server
    - git
    - curl
    - ca-certificates
  late-commands:
    # Copy the FXRoute payload from the installation medium. Single quotes
    # on the outside only (Subiquity swallows nested quoting).
    - 'cp -r /cdrom/fxroute-iso /target/opt/fxroute-iso'
    - 'cp /target/opt/fxroute-iso/scripts/first-boot-install-ubuntu.sh /target/usr/local/libexec/fxroute-first-boot-install.sh'
    - 'chmod 755 /target/usr/local/libexec/fxroute-first-boot-install.sh'
    - 'cp /target/opt/fxroute-iso/first-boot.service /target/etc/systemd/system/fxroute-first-boot.service'
    - 'curtin in-target --target=/target -- systemctl enable fxroute-first-boot.service'
    - 'curtin in-target --target=/target -- systemctl enable ssh.service'
