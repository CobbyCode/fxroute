[Unit]
Description=FXRoute QEMU test SSH hook (inert without fxroute.live-password)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/libexec/fxroute-test-ssh.sh

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/fxroute-test-ssh.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
