/* SPDX-License-Identifier: AGPL-3.0-only */
/*
 * Narrow FXRoute polkit rule.
 *
 * This .rules file is installed by install.sh into
 *   /etc/polkit-1/rules.d/50-fxroute-power.rules
 *
 * Its only purpose is to let the user running the FXRoute systemd --user
 * service (and only that user) trigger the systemd-logind/systemd-hostnamed
 * actions that the FXRoute web UI exposes through /api/system/power/* and
 * /api/system/device-name, plus the tightly scoped Avahi restart that
 * /api/system/device-name needs to advertise the new name immediately:
 *
 *   - org.freedesktop.login1.suspend
 *   - org.freedesktop.login1.power-off
 *   - org.freedesktop.hostname1.set-static-hostname
 *   - org.freedesktop.systemd1.manage-units, but ONLY verb "restart" on
 *     unit "avahi-daemon.service" (every other unit/verb falls through
 *     to the normal polkit policy)
 *
 * Important: this rule does NOT grant any other privilege.  All other
 * polkit actions (other systemd units, rebooting, hibernate, package
 * management, network configuration, ...) must still go through the
 * user's normal polkit policies (interactive auth or admin membership).
 *
 * INSTALL_USER_PLACEHOLDER is replaced with the actual install user by
 * install.sh before the rule is written.  Removing or reinstalling the
 * file is done by uninstall.sh and install.sh respectively.
 */
polkit.addRule(function(action, subject) {
    if (subject.user !== "INSTALL_USER_PLACEHOLDER") {
        return;
    }
    if (action.id === "org.freedesktop.login1.suspend" ||
        action.id === "org.freedesktop.login1.power-off" ||
        action.id === "org.freedesktop.hostname1.set-static-hostname") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "restart" &&
        action.lookup("unit") === "avahi-daemon.service") {
        return polkit.Result.YES;
    }
});
